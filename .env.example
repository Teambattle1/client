# Databasen portalen læser kunder fra. Uden de to første kører appen i
# demo-tilstand: den husker kun på den enkelte browser, og eksempelkunden
# er den eneste der findes.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Koden der åbner admin-delen fra forsiden.
# Den RIGTIGE kontrol sker i databasen (portal_config-tabellen) — det her er
# kun til demo-tilstand, hvor der ingen database er.
VITE_ADMIN_CODE=100408
